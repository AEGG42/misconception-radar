# The app runs without credentials using the deterministic demo engine.
AI_PROVIDER=deterministic

# Optional live provider configuration. Never commit a real value.
ENABLE_LIVE_AI=false

# Recommended judged-build provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Alternate structured-output provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Resolves canonical social image URLs in production metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
